# Generate your local .env with: python scripts/configure.py
POSTGRES_PASSWORD=replace_with_random_url_safe_password
APP_PORT=8000
COOKIE_SECURE=false
ENABLE_DEMO=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# For public HTTPS: DOMAIN=agro.example.com, COOKIE_SECURE=true,
# ALLOWED_ORIGINS=https://agro.example.com
DOMAIN=localhost
# Local development uses SQLite by default. Docker sets PostgreSQL automatically.
# DATABASE_URL=postgresql+psycopg://agrobalance:password@localhost:5432/agrobalance
