  "components": {
    "schemas": {
      "CalculateInput": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "eto": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 30.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Eto"
          },
          "effective_rain": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Effective Rain"
          }
        },
        "type": "object",
        "required": [
          "day",
          "effective_rain"
        ],
        "title": "CalculateInput"
      },
      "CropInput": {
        "properties": {
          "kc_initial": {
            "type": "number",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Kc Initial"
          },
          "kc_mid": {
            "type": "number",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Kc Mid"
          },
          "kc_end": {
            "type": "number",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Kc End"
          },
          "days_initial": {
            "type": "integer",
            "maximum": 365.0,
            "exclusiveMinimum": 0.0,
            "title": "Days Initial"
          },
          "days_development": {
            "type": "integer",
            "maximum": 365.0,
            "exclusiveMinimum": 0.0,
            "title": "Days Development"
          },
          "days_mid": {
            "type": "integer",
            "maximum": 365.0,
            "exclusiveMinimum": 0.0,
            "title": "Days Mid"
          },
          "days_late": {
            "type": "integer",
            "maximum": 365.0,
            "exclusiveMinimum": 0.0,
            "title": "Days Late"
          },
          "source": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "kc_initial",
          "kc_mid",
          "kc_end",
          "days_initial",
          "days_development",
          "days_mid",
          "days_late",
          "source"
        ],
        "title": "CropInput"
      },
      "FieldInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "area": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Area"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "location": {
            "type": "string",
            "maxLength": 100,
            "title": "Location",
            "default": ""
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Chisinau"
          },
          "soil": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Soil"
          },
          "crop_id": {
            "type": "integer",
            "title": "Crop Id"
          },
          "planting_date": {
            "type": "string",
            "format": "date",
            "title": "Planting Date"
          },
          "irrigation_type": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Irrigation Type"
          },
          "efficiency": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Efficiency"
          },
          "taw": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Taw"
          },
          "p": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "P"
          },
          "initial_deficit": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Deficit"
          },
          "target_deficit": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
